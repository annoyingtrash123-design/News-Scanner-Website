PORT=3000
# Minutes between checks of every watched page
CHECK_INTERVAL_MINUTES=30

# Optional: if set, the web UI asks for this password
APP_PASSWORD=
# Optional: secret used to sign login cookies (defaults to a key derived from APP_PASSWORD)
SESSION_SECRET=

# SMTP (example: Gmail with an app password). If SMTP_HOST is empty, emails are logged to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="News Scanner <you@gmail.com>"

# Default recipient (can be changed in the UI)
NOTIFY_EMAIL=you@gmail.com

# Where data/db.json lives (default ./data)
# DATA_DIR=./data
