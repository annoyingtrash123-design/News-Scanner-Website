# For running `npm run check` locally. In GitHub, set these as repository secrets instead.
# If SMTP_HOST is empty, emails are logged to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="News Scanner <you@gmail.com>"

# Fallback recipient when data/watchlist.json has no notifyEmail
NOTIFY_EMAIL=you@gmail.com

# Optional: check only one watch id; or use another data folder
# WATCH_ID=
# DATA_DIR=./data
